const { nome, size = 20, class: cls } = Astro.props;
---
<svg
  class:list={['ico', cls]}
  aria-hidden="true"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.9"
  stroke-linecap="round"
  stroke-linejoin="round"
  set:html={ICONE[nome]}
/>
