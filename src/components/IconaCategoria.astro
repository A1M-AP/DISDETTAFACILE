---
// Icona e tinta per categoria (solo decorative). Slug sconosciuti usano l'icona documento.
interface Props {
  slug: string;
}
const { slug } = Astro.props;

const icone: Record<string, { tinta: string; path: string }> = {
  'telefonia-internet': {
    tinta: 'var(--sky)',
    path: '<rect x="6.5" y="2.5" width="11" height="19" rx="2.5"/><path d="M10.5 18.5h3"/><path d="M2 8.5a8 8 0 0 1 2-3M22 8.5a8 8 0 0 0-2-3"/>',
  },
  'pay-tv-streaming': {
    tinta: 'var(--violet)',
    path: '<rect x="2.5" y="4.5" width="19" height="13" rx="3"/><path d="m10.5 8.5 4 2.5-4 2.5z"/><path d="M8 21h8"/>',
  },
  palestre: {
    tinta: 'var(--accent)',
    path: '<path d="M6.5 6v12M17.5 6v12M3.5 9v6M20.5 9v6M6.5 12h11"/>',
  },
  assicurazioni: {
    tinta: 'var(--mint)',
    path: '<path d="M12 2.5 4.5 5.5v6c0 4.6 3.2 8.4 7.5 10 4.3-1.6 7.5-5.4 7.5-10v-6z"/><path d="m8.5 12 2.5 2.5 4.5-5"/>',
  },
  'luce-gas': {
    tinta: 'var(--amber)',
    path: '<path d="M13.5 2.5 5 13.5h6.5l-1 8 8.5-11h-6.5z"/>',
  },
  abbonamenti: {
    tinta: 'var(--rose)',
    path: '<path d="M4 4.5h12.5v14a2 2 0 0 0 2 2H6a2 2 0 0 1-2-2z"/><path d="M16.5 8.5H20v10a2 2 0 0 1-2 2"/><path d="M7.5 8.5h5.5M7.5 12h5.5M7.5 15.5h3"/>',
  },
  'recesso-14-giorni': {
    tinta: 'var(--accent)',
    path: '<path d="M3.5 12a8.5 8.5 0 1 0 2.5-6"/><path d="M3 3.5v4h4"/><path d="M12 7.5V12l3 2"/>',
  },
};
const icona = icone[slug] ?? {
  tinta: 'var(--muted)',
  path: '<path d="M6 2.5h8l4 4v15H6z"/><path d="M14 2.5v4h4M9 12h6M9 16h6"/>',
};
---
<span class="card-icona" style={`--tinta:${icona.tinta}`} aria-hidden="true">
  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={icona.path} />
</span>
